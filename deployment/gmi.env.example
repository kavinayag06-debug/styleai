# Use these values only inside a real GMI Cloud deployment.
# Do not set INFERENCE_PLATFORM=gmi-cloud when running on Kaggle or a local machine.
INFERENCE_PLATFORM=gmi-cloud
GMI_DEPLOYMENT_ID=replace-with-the-real-gmi-deployment-or-instance-id
FASHN_TIMESTEPS=20
FASHN_WEIGHTS_DIR=/weights

# Inject these through GMI's secret-management/configuration mechanism.
OPENAI_API_KEY=
EXA_API_KEY=
HF_TOKEN=
